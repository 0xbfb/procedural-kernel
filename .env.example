
# UBU release configuration
# Copie para .env para configurar valores locais.
# O .env real deve permanecer ignorado pelo Git.

# Repo oficial do kit de orquestracao UBU.
# Deve existir em todos os projetos que seguem UBU ISO 3.1.
UBU_KIT_REPO_URL=https://github.com/0xbfb/ubu-suite.git
UBU_OFFICIAL_KIT_REPO_URL=https://github.com/0xbfb/ubu-suite.git

# Repo do projeto atual. Pode ser sobrescrito por -RepoUrl.
UBU_PROJECT_REPO_URL=https://github.com/0xbfb/ubu-suite.git
UBU_REPO_URL=https://github.com/0xbfb/ubu-suite.git

# Config release config-first.
UBU_RELEASE_CONFIG_PATH=release.config.json
UBU_RELEASE_VERSION=0.3.5
UBU_RELEASE_KIND=release
UBU_RELEASE_TITLE=UBU orchestration suite
UBU_RELEASE_DESCRIPTION=Adiciona padrao config-first para releases e prepara autoatualizacao do governor antes da publicacao.
UBU_PATCH_TITLE=
UBU_PATCH_DESCRIPTION=

# Branches padrao.
UBU_SOURCE_BRANCH=dev
UBU_RELEASE_BRANCH_PREFIX=release/
UBU_NIGHTLY_BRANCH=nightly
UBU_STABLE_BRANCH=stable
UBU_TAG_PREFIX=v

# Governor update.
# Em 0.3.5 o release deve verificar o repo oficial antes de publicar e tolerar configs legadas sem kit.version.
UBU_CHECK_KIT_UPDATES_BEFORE_RELEASE=true
UBU_AUTO_UPDATE_GOVERNOR=true
UBU_AUTO_UPDATE_POLICY=compatible_only
UBU_SKIP_KIT_UPDATE=false
