{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ubu.local/schemas/ubu-version-chain.schema.json",
  "title": "UBU Version Chain Contract",
  "type": "object",
  "required": ["schemaVersion", "project", "release", "branches", "commits", "push", "safety"],
  "properties": {
    "schemaVersion": { "type": "string" },
    "project": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" },
        "repository": { "type": "string" }
      }
    },
    "release": {
      "type": "object",
      "required": ["channel", "targetVersion", "promoteTo"],
      "properties": {
        "channel": { "enum": ["patch", "release", "nightly", "stable"] },
        "targetVersion": { "type": "string" },
        "promoteTo": {
          "type": "array",
          "items": { "enum": ["release", "nightly", "stable"] }
        },
        "tagPrefix": { "type": "string" },
        "tagMessage": { "type": "string" }
      }
    },
    "branches": {
      "type": "object",
      "required": ["patch", "release", "nightly", "stable"],
      "properties": {
        "patch": { "type": "string" },
        "release": { "type": "string" },
        "nightly": { "type": "string" },
        "stable": { "type": "string" }
      }
    },
    "commits": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["message"],
        "properties": {
          "message": { "type": "string" },
          "include": { "type": "array", "items": { "type": "string" } },
          "allowEmpty": { "type": "boolean" }
        }
      }
    },
    "commands": {
      "type": "object",
      "properties": {
        "beforeAll": { "type": "array", "items": { "type": "string" } },
        "validation": { "type": "array", "items": { "type": "string" } },
        "afterAll": { "type": "array", "items": { "type": "string" } }
      }
    },
    "push": {
      "type": "object",
      "required": ["enabled", "remote", "branches", "tags"],
      "properties": {
        "enabled": { "type": "boolean" },
        "remote": { "type": "string" },
        "branches": { "type": "boolean" },
        "tags": { "type": "boolean" }
      }
    },
    "safety": {
      "type": "object",
      "properties": {
        "requireCleanWorkingTree": { "type": "boolean" },
        "requireBranch": { "type": ["string", "null"] },
        "allowBranchCreate": { "type": "boolean" },
        "allowBranchReset": { "type": "boolean" }
      }
    }
  }
}
