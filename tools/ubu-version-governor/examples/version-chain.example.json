{
  "schemaVersion": "1.0",
  "project": {
    "name": "ubu-version-governor",
    "version": "0.1.0",
    "repository": ""
  },
  "release": {
    "channel": "release",
    "targetVersion": "0.1.0",
    "promoteTo": [
      "release",
      "nightly"
    ],
    "tagPrefix": "v",
    "tagMessage": "Release 0.1.0"
  },
  "branches": {
    "patch": "patch/{version}",
    "release": "release/{version}",
    "nightly": "nightly",
    "stable": "stable"
  },
  "commits": [
    {
      "message": "chore(release): prepare 0.1.0",
      "include": [
        "."
      ],
      "allowEmpty": false
    }
  ],
  "commands": {
    "beforeAll": [],
    "validation": [
      "python -m ubu_version_governor validate --input examples/version-chain.example.json"
    ],
    "afterAll": []
  },
  "push": {
    "enabled": true,
    "remote": "origin",
    "branches": true,
    "tags": true,
    "forceWithLease": true
  },
  "safety": {
    "requireCleanWorkingTree": false,
    "requireBranch": null,
    "allowBranchCreate": true,
    "allowBranchReset": false
  },
  "docs": {
    "releaseNotesPath": "docs/releases/RELEASE-0.1.0.md",
    "patchNotesPath": "docs/releases/PATCH-0.1.0.md"
  }
}
